{
  "expo": {
    "name": "Doovly",
    "slug": "doovly",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "doovly",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash_screen.png",
      "resizeMode": "contain",
      "backgroundColor": "#16A34A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.johnjerry.doovly",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Doovly needs your location to show nearby service professionals.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Doovly needs your location to show nearby service professionals.",
        "NSPhotoLibraryUsageDescription": "Doovly needs access to your photos so you can attach images when reporting an issue.",
        "NSCameraUsageDescription": "Doovly needs camera access so you can take photos when reporting an issue.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.johnjerry.doovly",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_screen.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#16A34A"
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Doovly to use your location to show nearby services."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Doovly to access your photos so you can attach images when reporting an issue.",
          "cameraPermission": "Allow Doovly to use your camera so you can take photos when reporting an issue."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#16A34A",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c730012-8237-4f60-83af-53a64e6beaf8"
      }
    }
  }
}
