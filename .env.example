# Copy this file to .env and fill in real values.
# Never commit .env with secrets.

# API (when backend is ready)
EXPO_PUBLIC_API_URL=

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary (Dashboard → copy Cloud Name)
# Upload preset must be UNSIGNED (Settings → Upload → Upload presets)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dbnykeelb
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=doovly

# RevenueCat (Dashboard → Project → API keys)
# Use the public SDK keys (appl_… / goog_…), not the secret key
EXPO_PUBLIC_REVENUECAT_APPLE_API_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=
