# Copy this file to .env and fill in real values.
# Never commit .env with secrets.

# API (when backend is ready)
EXPO_PUBLIC_API_URL=

# Supabase
# After `supabase db reset`, seed users exist (password: password123).
# IDs: src/lib/ids.ts  |  parity: supabase/PARITY.md
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary (Dashboard → copy Cloud Name)
# Upload preset must be UNSIGNED (Settings → Upload → Upload presets)
# Seed images use mock://profile_N.jpg until you upload real URLs.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=dbnykeelb
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=doovly
